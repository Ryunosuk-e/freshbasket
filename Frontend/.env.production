# Production environment — used automatically by Vite when building for production
# Replace the URL below with your actual Railway backend URL after deploying the backend
# Example: https://freshbasket-api-production.up.railway.app

VITE_API_BASE_URL=https://freshbasket-4asm.onrender.com

# Your Paystack PUBLIC key (starts with pk_live_ or pk_test_)
# Safe to commit — this is the public-facing key, NOT the secret key
VITE_PAYSTACK_PUBLIC_KEY=
