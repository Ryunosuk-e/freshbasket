# Production environment — used by Vite when running `npm run build`
# Set this to your Render.com backend URL after deploying the backend

VITE_API_BASE_URL=https://freshbasket-api.onrender.com

# Your Paystack PUBLIC key (starts with pk_live_ or pk_test_)
# Safe to commit — this is the public key, NOT the secret key
VITE_PAYSTACK_PUBLIC_KEY=
