# Copy to .env and adjust if your backend runs somewhere other than localhost:5000
VITE_API_BASE_URL=http://localhost:5000

# Optional — needed for the card payment option at checkout. Same
# Paystack account as the backend's PAYSTACK_SECRET_KEY, but this is the
# PUBLIC key (starts with pk_test_ in test mode) — safe to expose in
# frontend code, unlike the secret key. Without it, checkout still works
# via Cash on Delivery.
VITE_PAYSTACK_PUBLIC_KEY=
