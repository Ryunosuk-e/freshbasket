# Copy this file to .env and fill in real values. Never commit .env itself.

PORT=5000

# Postgres connection string
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/grocery_market

# frontend url
FRONTEND_URL=https://freshbasketdemo.netlify.app/

# Use a long, random string in real deployments (e.g. `openssl rand -hex 32`)
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=24h

# Matches NFR02 in the project report (bcrypt salt factor 12)
BCRYPT_SALT_ROUNDS=12

# Used only by `npm run db:seed-admin` to create the first admin account
SEED_ADMIN_NAME=Platform Admin
SEED_ADMIN_EMAIL=admin@grocerymarket.test
SEED_ADMIN_PHONE=08000000000
SEED_ADMIN_PASSWORD=ChangeMe123!

# Optional — product photo uploads (see README section on Product Catalogue).
# Free tier at cloudinary.com; without these, products can still be created,
# just without images. Find these three values on your Cloudinary dashboard
# home page after signing up — no card required for the free tier.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional — card payments at checkout (see README's Checkout & Payment
# section). Without this, checkout still works via Cash on Delivery.
# Free test-mode keys: create an account at dashboard.paystack.com, then
# Settings -> API Keys & Webhooks. Use the "Secret Key" (starts with sk_test_).
PAYSTACK_SECRET_KEY=
